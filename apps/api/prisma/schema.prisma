generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  APPROVED
  QUEUED
  PRINTING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  RETRYING
  PARTIALLY_COMPLETED
}

enum PrintJobStatus {
  PENDING
  ASSIGNED
  DOWNLOADING
  PRINTING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum ColorMode {
  BW
  COLOR
}

enum PaperSize {
  A4
  A3
  LETTER
}

enum WithdrawalSource {
  REFERRAL
  EARNINGS
}

enum WithdrawalMethod {
  UPI
  BANK
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum CreditPurchaseStatus {
  CREATED
  PAID
  FAILED
}

enum WhatsAppConnectionStatus {
  OFFLINE
  PAIRING
  CONNECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  memberships  ShopStaff[]
  merchants    Merchant[]
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralCode String?  @unique
  referredById String?
  referredBy   Merchant?  @relation("MerchantReferrals", fields: [referredById], references: [id])
  referrals    Merchant[] @relation("MerchantReferrals")

  walletAvailable Decimal @default(0) @db.Decimal(10, 2)
  walletLocked    Decimal @default(0) @db.Decimal(10, 2)
  walletReserved  Decimal @default(0) @db.Decimal(10, 2)
  walletWithdrawn Decimal @default(0) @db.Decimal(10, 2)
  walletCancelled Decimal @default(0) @db.Decimal(10, 2)
  walletReversed  Decimal @default(0) @db.Decimal(10, 2)

  creditsIncluded  Int @default(50)
  creditsUsed      Int @default(0)
  creditsPurchased Int @default(0)

  planCode              String?
  planDurationMonths    Int?
  subscriptionExpiresAt DateTime?

  withdrawalRequests WithdrawalRequest[]
  creditPurchases    CreditPurchase[]
  planPurchases      PlanPurchase[]

  @@index([ownerId])
}

model Shop {
  id              String         @id @default(cuid())
  merchantId      String
  merchant        Merchant       @relation(fields: [merchantId], references: [id])
  name            String
  slug            String         @unique
  address         String?
  city            String?
  state           String?
  phone           String?
  isActive        Boolean        @default(true)
  autoPrint       Boolean        @default(false)
  requireApproval Boolean        @default(true)
  capabilities      Json?
  capabilitiesOrder Json?
  advancedServicesEnabled Boolean @default(true)
  physicalServicesEnabled Boolean @default(true)

  collageEnabled       Boolean @default(false)
  mergeEnabled         Boolean @default(false)
  collagePricing       Json?
  mergePricing         Json?
  bulkPricingEnabled   Boolean @default(false)
  bulkPricingThreshold Decimal? @db.Decimal(10, 2)
  bulkPricingRates     Json?
  copyDiscountEnabled  Boolean @default(false)
  copyDiscountRates    Json?

  useOwnRazorpay        Boolean  @default(false)
  razorpayKeyId         String?
  razorpayKeySecret     String?
  onlinePaymentsEnabled Boolean  @default(false)
  allowManualPayment    Boolean  @default(true)
  checkoutDisplayName   String?
  paymentLogoUrl        String?
  currency              String   @default("INR")
  upiId                 String?
  minOrderAmount        Decimal? @db.Decimal(10, 2)
  maxFileSizeMb         Int?     @default(25)

  portalCustomerDetailsEnabled Boolean @default(true)
  portalRequireName            Boolean @default(true)
  portalRequirePhone           Boolean @default(true)
  portalCategoryToggles        Json?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  staff           ShopStaff[]
  printers        Printer[]
  agents          Agent[]
  pricingRules    PricingRule[]
  orders          Order[]
  customers       Customer[]
  withdrawalRequests WithdrawalRequest[]
  whatsappSession    WhatsAppSession?

  @@index([merchantId])
}

model ShopStaff {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())

  @@unique([shopId, userId])
  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([shopId, phone])
}

model PricingRule {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id])
  name          String
  paperSize     PaperSize @default(A4)
  colorMode     ColorMode @default(BW)
  duplex        Boolean   @default(false)
  pricePerPage  Decimal   @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shopId, isActive])
  @@unique([shopId, paperSize, colorMode, duplex])
}

model Agent {
  id           String    @id @default(cuid())
  shopId       String
  shop         Shop      @relation(fields: [shopId], references: [id])
  name         String
  deviceKey    String    @unique
  tokenHash    String?
  isOnline     Boolean   @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  printers     Printer[]
  printJobs    PrintJob[]

  @@index([shopId])
}

model Printer {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  agentId      String?
  agent        Agent?   @relation(fields: [agentId], references: [id])
  name         String
  systemName   String
  isOnline     Boolean  @default(false)
  isEnabled    Boolean  @default(true)
  supportsColor Boolean @default(false)
  supportsDuplex Boolean @default(false)
  paperSizes   Json
  priority     Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  printJobs    PrintJob[]

  @@index([shopId, isEnabled])
  @@index([agentId])
}

model Order {
  id              String      @id @default(cuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  status          OrderStatus @default(DRAFT)
  paperSize       PaperSize   @default(A4)
  colorMode       ColorMode   @default(BW)
  duplex          Boolean     @default(false)
  copies          Int         @default(1)
  pageCount       Int         @default(1)
  pageRange       String?
  orientation     String      @default("portrait")
  unitPrice       Decimal     @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  currency        String      @default("INR")
  customerName    String?
  customerPhone   String?
  notes           String?     @db.Text
  paymentMethod   String?
  rejectedReason  String?
  paidAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  files           OrderFile[]
  printJobs       PrintJob[]
  payments        Payment[]

  @@index([shopId, status, createdAt])
  @@index([customerId])
}

model OrderFile {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  pageCount    Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([orderId])
}

model PrintJob {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  shopId        String
  agentId       String?
  agent         Agent?         @relation(fields: [agentId], references: [id])
  printerId     String?
  printer       Printer?       @relation(fields: [printerId], references: [id])
  status        PrintJobStatus @default(PENDING)
  idempotencyKey String        @unique
  attempts      Int            @default(0)
  lastError     String?        @db.Text
  assignedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([shopId, status])
  @@index([agentId, status])
  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  shopId            String
  provider          String        @default("mock")
  status            PaymentStatus @default(CREATED)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  providerOrderId   String?
  providerPaymentId String?
  rawPayload        Json?
  settlementMode    String        @default("PLATFORM")
  withdrawalId      String?
  withdrawal        WithdrawalRequest? @relation(fields: [withdrawalId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([shopId])
  @@index([providerPaymentId])
  @@index([withdrawalId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())
  payload     Json

  @@unique([provider, eventId])
}

model WithdrawalRequest {
  id            String            @id @default(cuid())
  merchantId    String
  merchant      Merchant          @relation(fields: [merchantId], references: [id])
  shopId        String?
  shop          Shop?             @relation(fields: [shopId], references: [id])
  source        WithdrawalSource
  amountGross   Decimal           @db.Decimal(10, 2)
  commissionPct Decimal           @default(0) @db.Decimal(5, 2)
  amountNet     Decimal           @db.Decimal(10, 2)
  method        WithdrawalMethod
  destination   String
  status        WithdrawalStatus  @default(PENDING)
  payments      Payment[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([merchantId, status])
  @@index([shopId, status])
}

model CreditPurchase {
  id                String               @id @default(cuid())
  merchantId        String
  merchant          Merchant             @relation(fields: [merchantId], references: [id])
  qty               Int
  amount            Decimal              @db.Decimal(10, 2)
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            CreditPurchaseStatus @default(CREATED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([merchantId, status])
}

model PlanPurchase {
  id                String               @id @default(cuid())
  merchantId        String
  merchant          Merchant             @relation(fields: [merchantId], references: [id])
  planCode          String
  months            Int
  amount            Decimal              @db.Decimal(10, 2)
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            CreditPurchaseStatus @default(CREATED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([merchantId, status])
}

model WhatsAppSession {
  id              String                   @id @default(cuid())
  shopId          String                   @unique
  shop            Shop                     @relation(fields: [shopId], references: [id])
  status          WhatsAppConnectionStatus @default(OFFLINE)
  phoneNumber     String?
  lastConnectedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

enum AgentPlatform {
  WINDOWS
  MACOS
  LINUX
}

enum AgentArch {
  X64
  ARM64
  X86
}

model AgentBuild {
  id            String        @id @default(cuid())
  version       String
  platform      AgentPlatform
  arch          AgentArch
  fileName      String
  fileSizeBytes Int
  downloadUrl   String
  releasedAt    DateTime      @default(now())

  @@unique([platform, arch, version])
}

model AuditLog {
  id         String   @id @default(cuid())
  shopId     String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([shopId, createdAt])
}
