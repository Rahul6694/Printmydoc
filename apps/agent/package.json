{
  "name": "@printmydoc/agent",
  "version": "0.1.0",
  "private": true,
  "description": "PrintMyDoc counter agent — detects local printers and prints incoming orders",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --mac --win"
  },
  "dependencies": {
    "pdf-to-printer": "^5.8.1",
    "unix-print": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "in.printmydoc.agent",
    "productName": "PrintMyDoc Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
